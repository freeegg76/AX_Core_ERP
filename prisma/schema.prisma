  @@id([company_id, entity_id, employee_Id], map: "PK_system_employee")
}

model system_entity {
  company_id           String                 @db.VarChar(10)
  entity_id            String                 @db.VarChar(10)
  entity_name          String                 @db.NVarChar(50)
  entity_name_ko       String                 @db.NVarChar(50)
  RepName              String?                @db.NVarChar(100)
  RegNum               String?                @db.VarChar(20)
  BizNum               String?                @db.VarChar(20)
  BizIndustry          String?                @db.NVarChar(100)
  BizCategory          String?                @db.NVarChar(100)
  Address              String?                @db.NVarChar(255)
  estabilish_date      DateTime?              @db.Date
  PhoneNumber          String?                @db.VarChar(30)
  FaxNumber            String?                @db.VarChar(30)
  note                 String?                @db.NVarChar(200)
  description          String?                @db.NVarChar(200)
  status               Boolean                @default(false, map: "DF_entity_status")
  finance_bank_account finance_bank_account[]
  finance_dimension    finance_dimension[]
  finance_GL           finance_GL[]
  finance_ledger_head  finance_ledger_head[]
  partner_client       partner_client[]
  partner_term         partner_term[]
  partner_vendor       partner_vendor[]
  sales_pipeline       sales_pipeline[]
  system_company       system_company         @relation(fields: [company_id], references: [company_id], onUpdate: NoAction, map: "FK_entity_company")
  system_pod           system_pod[]
  system_team          system_team[]
  system_year          system_year[]

  @@id([company_id, entity_id], map: "PK_system_entity")
}

model system_pod {
  company_id    String        @db.VarChar(10)
  entity_id     String        @db.VarChar(10)
  pod_id        String        @db.VarChar(4)
  pod_name      String        @db.NVarChar(200)
  status        Boolean       @default(false, map: "DF_pod_status")
  system_entity system_entity @relation(fields: [company_id, entity_id], references: [company_id, entity_id], onUpdate: NoAction, map: "FK_pod_entity")
  system_team   system_team[]

  @@id([company_id, entity_id, pod_id], map: "PK_system_pod")
}

model system_team {
  company_id      String            @db.VarChar(10)
  entity_id       String            @db.VarChar(10)
  Team_id         String            @db.VarChar(10)
  team_name       String?           @db.NVarChar(200)
  team_name_ko    String?           @db.NVarChar(200)
  owner           String            @db.VarChar(20)
  leader_user_id  String            @db.VarChar(20)
  note            String?           @db.NVarChar(200)
  status          Boolean           @default(false, map: "DF_team_status")
  pod_id          String?           @db.VarChar(4)
  system_employee system_employee[]
  system_entity   system_entity     @relation(fields: [company_id, entity_id], references: [company_id, entity_id], onUpdate: NoAction, map: "FK_team_entity")
  system_pod      system_pod?       @relation(fields: [company_id, entity_id, pod_id], references: [company_id, entity_id, pod_id], onUpdate: NoAction, map: "FK_team_pod")

  @@id([company_id, entity_id, Team_id], map: "PK_system_team")
}

model system_year {
  company_id           String                 @db.VarChar(10)
  entity_id            String                 @db.VarChar(10)
  company_year_id      String                 @db.VarChar(10)
  company_year         Decimal                @db.Decimal(10, 2)
  actual_year          Decimal                @db.Decimal(10, 2)
  finance_closing      finance_closing?
  finance_open_balance finance_open_balance[]
  system_entity        system_entity          @relation(fields: [company_id, entity_id], references: [company_id, entity_id], onUpdate: NoAction, map: "FK_year_entity")

  @@id([company_id, entity_id, company_year_id], map: "PK_system_year")
  @@unique([company_id, entity_id, actual_year, company_year], map: "UQ_year_actual")
}
