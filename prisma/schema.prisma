generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model finance_bank_account {
  company_id            String                  @db.VarChar(10)
  entity_id             String                  @db.VarChar(10)
  bank_id               String                  @db.VarChar(10)
  bank_name             String?                 @db.NVarChar(50)
  bank_account          String?                 @db.VarChar(50)
  card_number           String?                 @db.VarChar(50)
  status                Boolean                 @default(false, map: "DF_bank_status")
  system_entity         system_entity           @relation(fields: [company_id, entity_id], references: [company_id, entity_id], onUpdate: NoAction, map: "FK_bank_entity")
  finance_ledger_detail finance_ledger_detail[]
  finance_open_balance  finance_open_balance[]

  @@id([company_id, entity_id, bank_id], map: "PK_finance_bank_account")
}

model finance_closing {
  company_id      String      @db.VarChar(10)
  entity_id       String      @db.VarChar(10)
  company_year_id String      @db.VarChar(10)
  closing         Boolean     @default(true, map: "DF_closing")
  closing_date    DateTime?   @db.Date
  system_year     system_year @relation(fields: [company_id, entity_id, company_year_id], references: [company_id, entity_id, company_year_id], onUpdate: NoAction, map: "FK_closing_year")

  @@id([company_id, entity_id, company_year_id], map: "PK_finance_closing")
}

model finance_dimension {
  company_id               String                     @db.VarChar(10)
  entity_id                String                     @db.VarChar(10)
  dimension_id             String                     @db.VarChar(10)
  dimension_name           String?                    @db.NVarChar(100)
  slot_no                  Int                        @db.TinyInt
  status                   Boolean                    @default(true, map: "DF_dim_status")
  system_entity            system_entity              @relation(fields: [company_id, entity_id], references: [company_id, entity_id], onUpdate: NoAction, map: "FK_dim_entity")
  finance_dimension_detail finance_dimension_detail[]

  @@id([company_id, entity_id, dimension_id], map: "PK_finance_dimension")
  @@unique([company_id, entity_id, slot_no], map: "UQ_dim_slot")
}

model finance_dimension_detail {
  company_id        String            @db.VarChar(10)
  entity_id         String            @db.VarChar(10)
  dimension_id      String            @db.VarChar(10)
  line_no           Decimal           @db.Decimal(10, 2)
  dimension_value   String?           @db.NVarChar(200)
  finance_dimension finance_dimension @relation(fields: [company_id, entity_id, dimension_id], references: [company_id, entity_id, dimension_id], onUpdate: NoAction, map: "FK_dimd_dim")

  @@id([company_id, entity_id, dimension_id, line_no], map: "PK_finance_dimension_detail")
}

model finance_GL {
  company_id            String                  @db.VarChar(10)
  entity_id             String                  @db.VarChar(10)
  gl_id                 String                  @db.VarChar(10)
  gl_name               String?                 @db.NVarChar(100)
  gl_type               String?                 @db.VarChar(50)
  gl_category1          String?                 @db.NVarChar(50)
  gl_category2          String?                 @db.NVarChar(50)
  vat_gl                String?                 @db.NVarChar(50)
  gl_detail             String?                 @default("0", map: "DF_gl_detail") @db.VarChar(10)
  contra_gl             String?                 @db.VarChar(10)
  status                Boolean                 @default(true, map: "DF_gl_status")
  bank_id               Boolean                 @default(false, map: "DF__finance_G__bank___17036CC0")
  Team_id               Boolean                 @default(false, map: "DF__finance_G__Team___17F790F9")
  pod_id                Boolean                 @default(false, map: "DF__finance_G__pod_i__18EBB532")
  employee_Id           Boolean                 @default(false, map: "DF__finance_G__emplo__19DFD96B")
  client_id             Boolean                 @default(false, map: "DF__finance_G__clien__1AD3FDA4")
  vendor_id             Boolean                 @default(false, map: "DF__finance_G__vendo__1BC821DD")
  dimension1            Boolean                 @default(false, map: "DF__finance_G__dimen__1CBC4616")
  dimension2            Boolean                 @default(false, map: "DF__finance_G__dimen__1DB06A4F")
  dimension3            Boolean                 @default(false, map: "DF__finance_G__dimen__1EA48E88")
  dimension4            Boolean                 @default(false, map: "DF__finance_G__dimen__1F98B2C1")
  dimension5            Boolean                 @default(false, map: "DF__finance_G__dimen__208CD6FA")
  due_date              Boolean                 @default(false, map: "DF__finance_G__due_d__2180FB33")
  system_entity         system_entity           @relation(fields: [company_id, entity_id], references: [company_id, entity_id], onUpdate: NoAction, map: "FK_gl_entity")
  finance_ledger_detail finance_ledger_detail[]
  finance_open_balance  finance_open_balance[]

  @@id([company_id, entity_id, gl_id], map: "PK_finance_GL")
}

