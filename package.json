    "db:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "argon2": "^0.41.1",
    "mssql": "^11.0.1",
    "prisma": "^6.1.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
