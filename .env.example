# AX Bridge 환경변수 템플릿
#
#   cp .env.example .env    후 실제 값으로 교체한다.
#   .env 는 .gitignore 로 제외되어 있다 — 실제 비밀번호를 이 파일에 적지 않는다.

# ── Database ────────────────────────────────────────────────────────────────
# ⚠ TCP/IP 가 활성화되어 있어야 한다. Node 드라이버(Prisma·node-mssql)는
#   공유 메모리·이름있는 파이프를 지원하지 않는다. README 의 설정 절차 참조.

# Prisma (조회 전용, 설계서 D2)
DATABASE_URL="sqlserver://localhost:1433;database=AX_BRIDGE;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# node-mssql (쓰기 = 저장 프로시저 실행, 설계서 D1)
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=AX_BRIDGE
MSSQL_USER=sa
MSSQL_PASSWORD=CHANGE_ME
MSSQL_ENCRYPT=true
# 개발용 자체서명 인증서를 신뢰한다. 운영에서는 false + 정식 인증서를 쓴다.
MSSQL_TRUST_SERVER_CERT=true

# ── Auth ────────────────────────────────────────────────────────────────────
# 운영에서는 반드시 난수로 교체한다:  openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=14d

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
API_PREFIX=api/v1
RATE_LIMIT_PER_MIN=120
CORS_ORIGIN=http://localhost:5173
